# Copy to .env locally. Never commit real keys.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

GEMINI_API_KEY=
GROQ_API_KEY=

# Current Gemini text models. Warren AI tries Flash first, then Flash-Lite.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Verify Groq model IDs in your provider dashboard before changing.
GROQ_MODEL=llama-3.3-70b-versatile
